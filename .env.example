# Copy to .env and fill in. .env is gitignored and must never be committed.

# TypeSafe Jev. Early access: https://typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Small text model, used only for turning "Portland" into PDX and "March 3" into a date.
# Any OpenAI-compatible endpoint works. Groq free tier: console.groq.com/keys (no card).
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.groq.com/openai/v1
TEXT_MODEL=openai/gpt-oss-20b
# Leave unset for Groq: the base URL selects reasoning_effort=low, which keeps gpt-oss from
# reasoning past max_tokens and returning truncated JSON. Set to "omit" only for a provider
# that rejects every reasoning field, or "none" to disable reasoning explicitly.
# TEXT_MODEL_REASONING=

# Alternative, needs OpenRouter credit:
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_REASONING=none
